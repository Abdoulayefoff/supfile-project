# ___________________________________________________________________________ SUPFILE - Configuration Template ___________________________________________________________________________

# ___________________ Database MySQL ___________________

# Mot de passe root MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=supfile_db
MYSQL_USER=supfile_user

# Mot de passe utilisateur MySQL
MYSQL_PASSWORD=change_me


# _____________________ Symfony Application _______________________

APP_ENV=dev

# Secret Symfony (OBLIGATOIRE - générer avec: openssl rand -hex 32)
APP_SECRET=change_me


# ___________________ JWT Authentication ____________________________

# Chemins vers les clés JWT (ne pas modifier sauf besoin spécifique)
# Les clés seront générées automatiquement avec :
#   docker compose exec api php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Passphrase pour les clés JWT (OBLIGATOIRE - générer avec: openssl rand -hex 32)
JWT_PASSPHRASE=change_me

# _______________________ OAuth2 Google __________________________

# Obtenir vos clés sur : https://console.cloud.google.com/
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter http://localhost:8000/api/auth/oauth/google/check dans les URIs de redirection

OAUTH_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret


# _________________________ OAuth2 GitHub ___________________________
# Obtenir sur : https://github.com/settings/developers
# 1. Créer une nouvelle OAuth App
# 2. Homepage URL: http://localhost:8000
# 3. Authorization callback URL: http://localhost:8000/api/auth/oauth/github/check

OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# _______________________ OAuth2 Microsoft ___________________________
# Obtenir sur : https://portal.azure.com/
# 1. Aller dans "Azure Active Directory" → "App registrations"
# 2. Créer une nouvelle application
# 3. Ajouter une "Web" platform avec redirect URI: http://localhost:8000/api/auth/oauth/microsoft/check
# 4. Dans "Certificates & secrets", créer un nouveau client secret
# 5. Dans "API permissions", ajouter Microsoft Graph permissions: openid, email, profile
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# _______________________ Frontend Web (React + Vite) _______________________

# URL de l'API depuis le navigateur (ne pas modifier sauf changement de port)
VITE_API_URL=http://localhost:8000/api


# _______________________ Frontend Mobile (React Native + Expo) ________________________

# IP de l'hôte Docker pour accès depuis appareil mobile physique
# Remplacer par votre IP locale (ex: 192.168.1.100)
# 
# Pour trouver votre IP locale :
#   - Linux/Mac: ip addr show | grep "inet " | grep -v 127.0.0.1
#   - Windows: ipconfig | findstr "IPv4"
#   - Alternative: hostname -I (Linux/Mac)
#
# Si vous testez uniquement sur émulateur, laisser "localhost"
HOST_IP=192.168.1.100

# URL de l'API depuis l'appareil mobile (utilise HOST_IP automatiquement)
# Ne pas modifier cette ligne, elle utilise la variable HOST_IP ci-dessus
EXPO_PUBLIC_API_URL=http://${HOST_IP}:8000/api


# Variable pour Symfony (Mercure ou Mailer)
DEFAULT_URI=
