# ==========================================
# SUPFILE - Configuration Template
# ==========================================
# INSTRUCTIONS :
# 1. Copier ce fichier : cp .env.example .env
# 2. Modifier les valeurs marquées "change_me"
# 3. NE JAMAIS commiter le fichier .env

# --- Database MySQL ---
DATABASE_URL=mysql://root:change_me_strong_password@database:3306/supfile_db?serverVersion=8.0&charset=utf8mb4
DATABASE_NAME=supfile_db
DATABASE_USER=root
DATABASE_PASSWORD=change_me_strong_password

# --- Symfony Application ---
APP_ENV=dev
APP_SECRET=change_me_random_32_chars_string_here

# --- JWT Authentication ---
# Ces chemins sont relatifs au dossier backend
# Les clés seront générées automatiquement avec : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_strong_passphrase_for_jwt

# --- OAuth2 Google ---
# Obtenir vos clés sur : https://console.cloud.google.com/
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter http://localhost:8000/api/auth/google/callback dans les URIs de redirection
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- OAuth2 GitHub (optionnel) ---
# Obtenir sur : https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- CORS Configuration ---
# Regex pour autoriser localhost sur tous les ports
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# --- Frontend Web (React + Vite) ---
VITE_API_URL=http://localhost:8000

# --- Frontend Mobile (React Native + Expo) ---
# Utiliser votre IP locale pour tests sur appareil physique
# Exemple : EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000