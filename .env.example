# Database
DATABASE_URL=mysql://root:password@database:3306/supfile_db
DATABASE_NAME=supfile_db
DATABASE_USER=root
DATABASE_PASSWORD=password

# JWT
JWT_SECRET_KEY=config/jwt/private.pem
JWT_PUBLIC_KEY=config/jwt/public.pem
JWT_PASSPHRASE=your_secret_passphrase

# OAuth2 Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS
CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:19006,exp://localhost:19000

# App
APP_ENV=dev
APP_SECRET=change_me_in_prod
