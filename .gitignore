# Git Ignore Configuration

# --- Environnement (CRITIQUE) ---
.env
.env.*
!.env.example
*.env.backup
.env.*.local

# Fichiers d'environnement dans les sous-dossiers
backend/.env
backend/.env.*
!backend/.env.example
frontend-web/.env
frontend-web/.env.*
!frontend-web/.env.example
frontend-mobile/.env
frontend-mobile/.env.*
!frontend-mobile/.env.example

# --- Secrets & Keys (CRITIQUE) ---
*.pem
*.key
*.crt
*-key.pem
*-cert.pem
backend/config/jwt/*.pem

# --- IDE (Configuration éditeur) ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
*.code-workspace
*.iml

# --- OS (Système d'exploitation) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db
Thumbs.db?
Desktop.ini
*~

# --- Logs ---
/log/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker volumes ---
mysql_data/
file_storage/
storage_data/

# --- Documentation temporaire & Backup ---
.tmp
*.bak
*.backup
*.temp

# --- Dépendances (CRITIQUE) ---
/node_modules/
/vendor/

# Backend PHP
backend/vendor/
backend/composer.lock

# Frontend Web (React)
frontend-web/node_modules/
frontend-web/package-lock.json
frontend-web/yarn.lock

# Frontend Mobile (Expo)
frontend-mobile/node_modules/
frontend-mobile/package-lock.json
frontend-mobile/yarn.lock

# --- Symfony compose files (on utilise docker-compose.yml à la racine) ---
backend/compose.yaml
backend/compose.override.yaml
backend/compose.yaml.backup
backend/compose.override.yaml.backup

# --- Build & Cache ---
# Symfony
backend/var/cache/
backend/var/log/
backend/var/sessions/

# React/Vite
frontend-web/dist/
frontend-web/.vite/
frontend-web/build/

# Expo
frontend-mobile/.expo/
frontend-mobile/.expo-shared/
frontend-mobile/dist/

# --- Uploads et fichiers utilisateurs ---
# Fichiers uploadés (dans Docker volume)
backend/storage/*
!backend/storage/.gitkeep

# Avatars uploadés
backend/public/uploads/avatars/*
!backend/public/uploads/avatars/.gitkeep

# Storage public (avatars, fichiers utilisateurs)
backend/public/storage/*
!backend/public/storage/.gitkeep

# --- Tests ---
coverage/
.nyc_output/
backend/.phpunit.result.cache
backend/phpunit.xml

# --- Divers ---
.cache/