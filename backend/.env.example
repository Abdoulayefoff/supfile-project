###> symfony/framework-bundle ###
APP_ENV=dev
# APP_SECRET injecté par Docker Compose depuis .env racine
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL injecté par Docker Compose depuis .env racine
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# JWT_PASSPHRASE injecté par Docker Compose depuis .env racine
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# ── Stockage : local (dev) ou azure (prod)
STORAGE_DRIVER=local

# ── Azure Blob Storage (laisser vide en dev, rempli sur Azure App Service en prod)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=files

# ── URL du frontend (utilisée pour le redirect OAuth et les liens emails)
FRONTEND_URL=http://localhost:3000

# ── Mailer
# En dev  : null://null (aucun email envoyé) ou credentials Mailtrap pour tester
# En prod : credentials Brevo via Azure App Service settings (ne jamais commiter)
MAILER_DSN=null://null
MAILER_FROM=noreply@supfile-cloud.fr