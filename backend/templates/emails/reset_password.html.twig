{#
   Template email — Réinitialisation de mot de passe SUPFile
   
   Variables reçues depuis PasswordResetService::requestReset() :
     - firstName        : prénom de l'utilisateur (ou "Utilisateur" par défaut)
     - resetLink        : URL complète avec le token (ex: https://...?token=abc)
     - expiresInMinutes : durée de validité du token (30 minutes)
    #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation du mot de passe</title>
    <style>
        /* Reset minimal pour une cohérence cross-client email */
        body {
            margin: 0;
            padding: 0;
            background: #f0f2f5;
            font-family: 'Helvetica Neue', Arial, sans-serif;
        }

        /* Conteneur principal centré, max 560px pour les clients desktop */
        .wrapper {
            max-width: 560px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        /* En-tête avec le dégradé bleu de la charte graphique SUPFile */
        .header {
            background: linear-gradient(135deg, #005bbf, #1a73e8);
            padding: 36px 40px;
            text-align: center;
        }
        .header-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        .header-logo-icon {
            width: 42px;
            height: 42px;
            background: rgba(255,255,255,0.2);
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .header-logo-text {
            font-size: 24px;
            font-weight: 900;
            color: white;
            letter-spacing: -0.03em;
        }

        /* Corps du message */
        .body {
            padding: 40px;
        }
        .greeting {
            font-size: 20px;
            font-weight: 700;
            color: #191c1d;
            margin-bottom: 16px;
        }
        .text {
            font-size: 15px;
            color: #414754;
            line-height: 1.7;
            margin-bottom: 16px;
        }

        /* Bouton CTA — centré, arrondi, dégradé bleu */
        .btn-wrapper {
            text-align: center;
            margin: 32px 0;
        }
        .btn {
            display: inline-block;
            background: linear-gradient(135deg, #005bbf, #1a73e8);
            color: white !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 700;
            padding: 14px 36px;
            border-radius: 9999px;
            box-shadow: 0 4px 16px rgba(0,91,191,0.35);
        }

        /* Avertissement expiration — fond jaune doux */
        .warning {
            background: #fff8e1;
            border-left: 4px solid #f59e0b;
            border-radius: 8px;
            padding: 14px 18px;
            font-size: 13px;
            color: #7c5c00;
            margin-bottom: 24px;
        }

        /* Lien de secours au cas où le bouton ne fonctionne pas */
        .link-fallback {
            font-size: 12px;
            color: #9aa0ae;
            word-break: break-all;
            margin-top: 8px;
        }

        /* Pied de page */
        .footer {
            background: #f8f9fb;
            padding: 24px 40px;
            text-align: center;
            font-size: 12px;
            color: #9aa0ae;
            border-top: 1px solid #e8eaf0;
        }
    </style>
</head>
<body>
    <div class="wrapper">

        {# ── En-tête avec le logo SUPFile ── #}
        <div class="header">
            <div class="header-logo">
                <span class="header-logo-icon">☁️</span>
                <span class="header-logo-text">SUPFile</span>
            </div>
        </div>

        {# ── Corps du message ── #}
        <div class="body">

            {# Salutation personnalisée avec le prénom de l'utilisateur #}
            <p class="greeting">Bonjour {{ firstName }} 👋</p>

            <p class="text">
                Vous avez demandé à réinitialiser le mot de passe de votre compte SUPFile.
                Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe.
            </p>

            {# Bouton principal — resetLink contient le token dans l'URL #}
            <div class="btn-wrapper">
                <a href="{{ resetLink }}" class="btn">
                    Réinitialiser mon mot de passe
                </a>
            </div>

            {# Avertissement sur la durée de validité du lien #}
            <div class="warning">
                ⚠️ Ce lien est valable pendant <strong>{{ expiresInMinutes }} minutes</strong> seulement.
                Après ce délai, vous devrez faire une nouvelle demande.
            </div>

            <p class="text">
                Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email —
                votre mot de passe restera inchangé.
            </p>

            {# Lien texte de secours si le bouton ne s'affiche pas correctement #}
            <p class="link-fallback">
                Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br>
                {{ resetLink }}
            </p>
        </div>

        {# ── Pied de page — année générée dynamiquement par Twig ── #}
        <div class="footer">
            © {{ "now"|date("Y") }} SUPFile · Cet email a été envoyé automatiquement, ne pas répondre.
        </div>

    </div>
</body>
</html>